          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Validate environment variables trước khi chạy",
                "const baseUrl = pm.collectionVariables.get('baseUrl');",
                "const authToken = pm.collectionVariables.get('authToken');",
                "",
                "if (!baseUrl) {",
                "  throw new Error('❌ baseUrl chưa được set! Vào Collection Variables để set.');",
                "}",
                "if (!authToken) {",
                "  console.warn('⚠️ authToken trống — chạy request 1.4 (Login) trước.');",
                "}",
