      "item": [

        {
          "name": "6.1 [Pre-request] Auto Login & Set Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"User123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Pre-request: đảm bảo baseUrl được set",
                "if (!pm.collectionVariables.get('baseUrl')) {",
                "  pm.collectionVariables.set('baseUrl', 'http://localhost:5000');",
                "}"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Auto-login thành công, token được set', () => {",
                "  pm.response.to.have.status(200);",
                "  const json = pm.response.json();",
                "  pm.expect(json.token).to.be.a('string');",
                "  pm.collectionVariables.set('authToken', json.token);",
                "  console.log('✅ authToken đã được set tự động');",
                "});",
                "",
                "// Hướng dẫn chạy Newman CLI:",
                "// npm install -g newman",
                "// newman run EduLearnOnline.postman_collection.json \\",
                "//   --environment EduLearnOnline.environment.json \\",
                "//   --reporters cli,json \\",
                "//   --reporter-json-export newman-report.json"
              ]}
            }
          ]
        },

